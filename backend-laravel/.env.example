APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Python NLP Screening Service
# NLP_SERVICE_URL=http://127.0.0.1:8001

# Google AI (Gemini) — shared 3rd fallback for AI chatbot + job-post drafts.
# Get a key from https://aistudio.google.com/apikey
# NOTE: never commit a real key here — .env.example is git-tracked.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=30

# Optional Gemini fallback key/model used when the primary key is rate-limited.
GEMINI_FALLBACK_API_KEY=
GEMINI_FALLBACK_MODEL=

# AI Chatbot (Landing + ESS share one chain):
# 1st Groq -> 2nd OpenRouter -> 3rd shared Gemini above.
# Get a Groq key from https://console.groq.com/keys
CHAT_GROQ_API_KEY=
CHAT_GROQ_MODEL=openai/gpt-oss-20b
# Get an OpenRouter key from https://openrouter.ai/keys
CHAT_OPENROUTER_API_KEY=
CHAT_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Job Post Builder (own Groq/OpenRouter keys, shared Gemini key above):
# 1st Groq -> 2nd OpenRouter -> 3rd shared Gemini.
JOB_GROQ_API_KEY=
JOB_GROQ_MODEL=openai/gpt-oss-20b
JOB_OPENROUTER_API_KEY=
JOB_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional app-level cap on successful AI job-post drafts per day
# (0 = unlimited). When set, the builder indicator shows used/remaining
# and the API answers 429 past the cap.
JOB_AI_DAILY_LIMIT=0

VITE_APP_NAME="${APP_NAME}"

# Security: Sanctum token expiration ceiling (minutes). Must stay >= the
# longest role lifetime (Employee 12h). Per-role lifetimes are enforced
# via each token's expires_at at login (see RoleSessionPolicy).
SANCTUM_TOKEN_EXPIRATION=720

# Portal idle auto-logout fallback (minutes of no mouse/keyboard activity)
# when the role map below is unavailable.
SESSION_IDLE_MINUTES=30

# Role-based session lifetimes (token minutes / idle minutes)
SESSION_MINUTES_SUPERADMIN=240
SESSION_IDLE_SUPERADMIN=10
SESSION_MINUTES_ADMIN=480
SESSION_IDLE_ADMIN=15
SESSION_MINUTES_EMPLOYEE=720
SESSION_IDLE_EMPLOYEE=30

# Weekly automatic backups: how many Automatic snapshots to keep
# (Manual backups are never pruned). Host must run `schedule:run` minutely.
BACKUP_KEEP_AUTOMATIC=8

# Frontend URL used for password-reset links etc. Must match the URL you
# open the app at (plain `npm run dev` serves http://localhost:5173;
# a `--port 5199` run needs http://localhost:5199 here instead).
FRONTEND_URL=http://localhost:5173

# AI Chatbot shares the Gemini key above (single GEMINI_* block) — the
# backend proxy keeps the key server-side. See GEMINI_MODEL / GEMINI_TIMEOUT
# in the Google AI block earlier in this file.
