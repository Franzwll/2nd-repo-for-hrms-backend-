# @zoom/meetingsdk@6.5.0 peers React 18 while the app is on React 19.
# npm is strict about peer ranges (bun, used locally, is lenient), so the
# Dokploy build fails with ERESOLVE without this. The SDK runs fine on
# React 19; revisit when Zoom ships a React-19-compatible peer range.
legacy-peer-deps=true
